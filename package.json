{
  "name": "resume",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node --watch dist/src/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsc -p tsconfig.test.json && node --test dist-test/test/profile.smoke.test.js"
  },
  "dependencies": {
    "@apollo/server": "5.4.0",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.2.3",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/graphql": "13.2.0",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.19.0",
    "graphql": "16.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.6",
    "@types/node": "22.15.30",
    "prisma": "6.19.0",
    "tsx": "4.20.5",
    "typescript": "5.8.3"
  }
}
